local function ApplyStyle(obj, cornerRadius)
    cornerRadius = cornerRadius or 8
    
    local stroke = Instance.new("UIStroke")
    stroke.Thickness = 1.5
    stroke.Color = Theme.Primary
    stroke.Transparency = 0.3
    stroke.Parent = obj
    
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, cornerRadius)
    corner.Parent = obj
    
    return stroke, corner
end

local function ApplyGradient(obj, color1, color2)
    local gradient = Instance.new("UIGradient")
    gradient.Color = ColorSequence.new{
        ColorSequenceKeypoint.new(0, color1 or Theme.Primary),
        ColorSequenceKeypoint.new(1, color2 or Theme.Secondary)
    }
    gradient.Parent = obj
    return gradient
end


function VoidHub.UpdateStats(earned, total, bounty)
    EarnedStat.SetValue(earned)
    TotalStat.SetValue(total)
    BountyStat.SetValue(bounty)
end

function VoidHub.SetTarget(name)
    TargetLabel.Text = "  Target: " .. (name or "None")
end

function VoidHub.SetStatus(text, statusType)
    StatusLabel.Text = "  Status: " .. text
    if statusType == "error" then
        StatusLabel.TextColor3 = Theme.Error
    elseif statusType == "success" then
        StatusLabel.TextColor3 = Theme.Success
    elseif statusType == "warning" then
        StatusLabel.TextColor3 = Theme.Warning
    else
        StatusLabel.TextColor3 = Theme.Text
    end
end

